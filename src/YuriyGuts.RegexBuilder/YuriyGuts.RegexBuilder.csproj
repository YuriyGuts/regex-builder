<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- NuGet package metadata -->
    <PackageId>RegexBuilder</PackageId>
    <Version>1.0.2</Version>
    <Authors>Yuriy Guts</Authors>
    <Description>.NET library for human-readable declaration of regular expressions without having to remember the regex syntax. Looks similar to Expression Trees in .NET.</Description>
    <Copyright>Copyright (c) 2011-2026 Yuriy Guts</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/YuriyGuts/regex-builder</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>regex regular-expression fluent declarative builder readable pattern</PackageTags>
    <PackageReleaseNotes>Update test/demo projects to .NET 8/10 LTS; migrate tests to MSTest SDK 4.1.0</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/YuriyGuts/regex-builder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
  </ItemGroup>
</Project>
